{
  "name": "open-purchase-cockpit",
  "version": "1.2.0",
  "private": true,
  "description": "Cockpit achats SAPUI5",
  "scripts": {
    "start": "ui5 serve --open index.html",
    "serve": "ui5 serve",
    "build": "ui5 build --clean-dest",
    "lint": "eslint webapp",
    "test": "npm run lint && npm run test:specs && npm run test:validation",
    "test:specs": "node scripts/validate-specs.mjs",
    "test:validation": "node scripts/validate-validation-loop.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report test-results/playwright-report",
    "test:unit": "ui5 serve --open test/unit/unitTests.qunit.html",
    "test:integration": "ui5 serve --open test/integration/opaTests.qunit.html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@ui5/cli": "^4.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "js-yaml": "^5.3.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
